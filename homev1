<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Controle de Gastos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
            .container-receita{
                max-width: 400px;
                margin: 100px auto;
                padding: 2rem;
                background: white;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0,0,0,0.3);
            }
    </style>
</head>
<body>
    <div class="container text-center">
        <div class="row">
            <div class="col"></div>
                <div class="col-6">
                    <div class="container-receita">
                        <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Valor:</label>
                            <input class="form-control" type="number" name="valor" required>
                        </div>


                        <button type="submit" class="btn btn-success w-100">Entrada</button>
                        <button type="submit" class="btn btn-danger w-100">Gasto</button>
                    </div>
                </div>
            <div class="col"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>